<% if(errors.length > 0) { %>
  <div style="background-color: #fee2e2; border-left: 4px solid #dc2626; padding: 12px 16px; margin: 16px 0; border-radius: 4px;">
    <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 8px;">
      <svg style="width: 20px; height: 20px; fill: #dc2626;" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
        <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-2h2v2zm0-4h-2V7h2v6z"/>
      </svg>
      <strong style="color: #dc2626; font-size: 16px;">Please fix the following errors:</strong>
    </div>
    <ul style="margin: 0; padding-left: 20px; color: #b91c1c; list-style-type: disc;">
      <% errors.forEach(error => { %>
        <li style="margin-bottom: 4px;"><%= error %></li>
      <% }) %>
    </ul>
  </div>
<% } %>